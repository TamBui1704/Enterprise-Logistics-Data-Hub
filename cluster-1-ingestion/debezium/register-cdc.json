{
  "name": "oracle-logistics-cdc-connector",
  "config": {
    "connector.class": "io.debezium.connector.oracle.OracleConnector",
    "tasks.max": "1",
    "database.hostname": "oracle-db",
    "database.port": "1521",
    "database.user": "c##dbzuser",
    "database.password": "dbz",
    "database.dbname": "FREE",
    "database.pdb.name": "FREEPDB1",
    "topic.prefix": "cdc_logistics_oracle",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:29092",
    "schema.history.internal.kafka.topic": "schema-changes.logistics",
    "table.include.list": "DEBEZIUM.DIM_CUSTOMERS,DEBEZIUM.DIM_SERVICES,DEBEZIUM.DIM_POS_LOCATIONS,DEBEZIUM.DIM_WEIGHT_TIERS,DEBEZIUM.DIM_ROUTING_TYPES,DEBEZIUM.DIM_DELIVERY_STATUSES,DEBEZIUM.DIM_FAILURE_REASONS,DEBEZIUM.SHIPMENT_BOOKINGS,DEBEZIUM.DELIVERY_REMUNERATIONS,DEBEZIUM.RETURN_REMUNERATIONS,DEBEZIUM.SHIPMENT_EVENT_TRACKINGS",
    "database.connection.adapter": "logminer",
    "signal.data.collection": "DEBEZIUM.DEBEZIUM_SIGNAL",
    "tombstones.on.delete": "false"
  }
}
